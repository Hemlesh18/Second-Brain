# Local LLM model served via Ollama (e.g. llama3, mistral)
LLM_MODEL=llama3

# Sentence-transformers model for embeddings (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Directory to scan when no explicit path is given to `ingest`
NOTES_DIR=~/notes

# Vector store persistence directory (defaults to ~/.second_brain/chroma_db)
# CHROMA_DIR=~/.second_brain/chroma_db

# RAG tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
